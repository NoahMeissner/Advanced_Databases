# Suburblens - template for the .env in the repo root.
#
# The .env itself is NOT in git (see .gitignore). Two ways to get one:
#
#   ./start.sh          creates a .env from this file on the first run and
#                       fills both PASSWORD lines with random passwords
#   cp .env.example .env    manually - then please replace the change-me
#                           placeholders with your own passwords
#
# The values are read by install/docker_compose.yml (via --env-file) and by
# paths.py (postgres_dsn() / neo4j_auth()).

# --- Postgres (PostGIS + H3) ------------------------------------------------
POSTGRES_DB=suburblens
POSTGRES_USER=suburblens
# ./start.sh overwrites this line with a random password.
POSTGRES_PASSWORD=change-me
# Host/port as seen from Python; the container publishes on 127.0.0.1 only.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Neo4j (APOC + GDS) -----------------------------------------------------
NEO4J_USER=neo4j
# ./start.sh overwrites this line with a random password.
NEO4J_PASSWORD=change-me
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687

# --- Web UIs ----------------------------------------------------------------
# Adminer  http://localhost:8080  (Server: postgres)
ADMINER_PORT=8080
# Metabase http://localhost:3000
METABASE_PORT=3000
